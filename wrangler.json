{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dundee-movers",
  "compatibility_date": "2024-09-01",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "dundeemovers.co.uk",
      "custom_domain": true
    },
    {
      "pattern": "www.dundeemovers.co.uk",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./frontend/dist",
    "not_found_handling": "single-page-application"
  }
}
